{
  "name": "fast-food-pos",
  "version": "1.0.0",
  "description": "Single-till point-of-sale: Express + MongoDB API serving a React ledger-style UI",
  "private": true,
  "license": "ISC",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed.js",
    "build": "cd client && npm install && npm run build",
    "test": "node --test controllers/*.test.js"
  },
  "type": "commonjs",
  "dependencies": {
    "express": "^5.2.1",
    "mongoose": "^9.10.0",
    "multer": "^2.3.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "nodemonConfig": {
    "watch": [
      "server.js",
      "routes",
      "controllers",
      "models"
    ]
  }
}
